<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ThunderFury.Core</AssemblyName>
    <RootNamespace>ThunderFury.Core</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Compile-time only: Jotunn itself is a shared runtime dependency the
      player installs separately as its own BepInEx plugin, so we don't
      want our own copy of Jotunn.dll (or BepInEx.dll/0Harmony.dll) copied
      into this mod's output — that would risk two copies loading at once.
    -->
    <PackageReference Include="JotunnLib" Version="2.29.2">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
