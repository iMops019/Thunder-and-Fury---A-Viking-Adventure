<Project>

  <!--
    Every project in this solution reads ValheimInstallDir from here.

    Set it once per machine as an environment variable named VALHEIM_INSTALL
    (System Properties -> Environment Variables), e.g.:
      VALHEIM_INSTALL = C:\Program Files (x86)\Steam\steamapps\common\Valheim

    Do NOT hardcode a path in this file and commit it — it's per-machine.
    A project can still override ValheimInstallDir locally via a
    Directory.Build.props.local.props-style import if needed later.
  -->
  <PropertyGroup>
    <ValheimInstallDir Condition="'$(ValheimInstallDir)' == ''">$(VALHEIM_INSTALL)</ValheimInstallDir>
    <ValheimManagedDir>$(ValheimInstallDir)\valheim_Data\Managed</ValheimManagedDir>
    <BepInExCoreDir>$(ValheimInstallDir)\BepInEx\core</BepInExCoreDir>
    <BepInExPluginsDir>$(ValheimInstallDir)\BepInEx\plugins</BepInExPluginsDir>

    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)packages</RestorePackagesPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <Target Name="EnsureValheimInstallDir" BeforeTargets="BeforeBuild">
    <Error
      Condition="'$(ValheimInstallDir)' == ''"
      Text="ValheimInstallDir is not set. Set a VALHEIM_INSTALL environment variable pointing at your Valheim install folder, then restart your shell/IDE." />
  </Target>

</Project>
