<Project>

  <!--
    Game/BepInEx/Jotunn references are no longer hand-wired here — every
    project instead references the official `JotunnLib` NuGet package,
    which ships its own MSBuild props (JotunnLibRefsCorlib.props, verified
    by extracting the real 2.29.2 .nupkg) that auto-locate VALHEIM_INSTALL
    (env var, or the Windows registry Steam install for app 892970 as a
    fallback — no env var needed on most machines) and wire up BepInEx,
    Harmony, and the publicized game assemblies for you.

    See DoPrebuild.props at the repo root for the one knob that controls
    whether Jotunn auto-generates those publicized assemblies.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)packages</RestorePackagesPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

</Project>
